    <string name="setting_units_title">Używaj jednostek metrycznych</string>
    <string name="setting_burn_in_title">Ogranicz wypalenie ekranu</string>
    <string name="setting_burn_in_desc">Co jakiś czas przesuwa panel i zegar o kilka pikseli. Domyślnie włączone \u2014 pomaga na ekranach OLED i plazmowych, na innych jest niezauważalne.</string>

